"""docmd: convert Office documents and PDFs to GitHub Flavored Markdown."""

from __future__ import annotations

import argparse
import base64
import hashlib
import math
import os
import re
import shutil
import sys
import tempfile
import threading
import unicodedata
from concurrent.futures import ThreadPoolExecutor, as_completed
from io import BytesIO
from pathlib import Path
from urllib.parse import quote, unquote

# Opt out of onnxruntime 1.29+ 1DS telemetry before any lazy import latches it.
os.environ.setdefault("ORT_DISABLE_TELEMETRY", "1")

VERSION = "0.2.1"

IMAGE_MIME_TYPES = {
    "png": "image/png",
    "jpeg": "image/jpeg",
    "jpg": "image/jpeg",
    "gif": "image/gif",
    "webp": "image/webp",
    "svg": "image/svg+xml",
    "bmp": "image/bmp",
    "tiff": "image/tiff",
    "wmf": "image/x-wmf",
    "emf": "image/x-emf",
    "jpx": "image/jpx",
    "jp2": "image/jp2",
    "jbig2": "image/jbig2",
}
IMAGE_TEXT_PREFIX = "> *[Image Text]*: "
SUPPORTED_EXTENSIONS = {".docx", ".pptx", ".pdf"}
TABLE_DELIMITER_CELL_RE = re.compile(r"^:?-{3,}:?$")
TABLE_ERROR = "table row column count does not match header"
LINK_RE = re.compile(
    r"!?\[[^\]]*\]\(\s*(?:<([^>]+)>|((?:[^()]|\([^()]*\))+?))(?:\s+[\"'][^)]*[\"'])?\s*\)"
)
REFERENCE_DEF_RE = re.compile(r"^\s{0,3}\[([^\]]+)\]:\s*(\S.*)$")
HTML_IMAGE_RE = re.compile(
    r"<img\b[^>]*\bsrc\s*=\s*(?:\"([^\"]+)\"|'([^']+)'|([^\s>]+))",
    re.IGNORECASE,
)
LIST_ITEM_RE = re.compile(
    r"^\s*[\u00b7\u2022\u25aa\u25ab\u25e6\u25cf\u25cb\u25a0\u25a1\u2013\u2014\u2043\-]\s+"
)
INLINE_PROTECT_RE = re.compile(
    r"(`+[^`]*?`+|!?\[[^\]]*\]\([^)]*\)|<[^>]+>|(?:https?://|www\.)\S+)"
)
TYPOGRAPHY_TRANSLATION = str.maketrans(
    {
        0x00A0: " ",
        0x2007: " ",
        0x200B: "",
        0x200C: "",
        0x200D: "",
        0x2010: "-",
        0x2011: "-",
        0x2012: "-",
        0x2013: "-",
        0x2014: "-",
        0x2015: "-",
        0x2018: "'",
        0x2019: "'",
        0x201A: "'",
        0x201B: "'",
        0x201C: '"',
        0x201D: '"',
        0x201E: '"',
        0x201F: '"',
        0x2026: "...",
        0x202F: " ",
        0x205F: " ",
        0x2060: "",
        0x3000: " ",
        0xFEFF: "",
        0xFFFD: "",
    }
)
# Retained for callers that used the old name; this is typography normalisation.
ASCII_TRANSLATION = TYPOGRAPHY_TRANSLATION

_QUIET = False


def log_info(message: str) -> None:
    if not _QUIET:
        print(f"docmd: {message}", file=sys.stderr)


def log_warning(message: str) -> None:
    print(f"docmd: warning: {message}", file=sys.stderr)


class CorruptDocumentError(Exception):
    """The input is not a readable document of the declared format."""


class EncryptedDocumentError(Exception):
    """The input is encrypted and no valid password was supplied."""


class OcrError(RuntimeError):
    """The OCR backend could not be loaded or configured."""


class BudgetError(RuntimeError):
    """A configured resource budget was exceeded."""


class ConversionOptions:
    def __init__(
        self,
        include_images: bool = True,
        use_ocr: bool = True,
        password: str | None = None,
        verify: bool = False,
        quiet: bool = False,
        stdout: bool = False,
        jobs: int = 1,
        sanitize: bool = True,
        max_bytes: int | None = None,
        max_pages: int | None = None,
        max_image_pixels: int | None = None,
    ) -> None:
        if jobs < 1:
            raise ValueError("jobs must be at least 1")
        self.include_images = include_images
        self.use_ocr = use_ocr
        self.password = password
        self.verify = verify
        self.quiet = quiet
        self.stdout = stdout
        self.jobs = jobs
        self.sanitize = sanitize
        self.max_bytes = max_bytes if max_bytes is not None else _env_budget(
            "DOCMD_MAX_BYTES", 100 * 1024 * 1024
        )
        self.max_pages = max_pages if max_pages is not None else _env_budget(
            "DOCMD_MAX_PAGES", 2_000
        )
        self.max_image_pixels = (
            max_image_pixels
            if max_image_pixels is not None
            else _env_budget("DOCMD_MAX_IMAGE_PIXELS", 100_000_000)
        )

    @classmethod
    def from_args(cls, args: argparse.Namespace) -> "ConversionOptions":
        password = args.password or os.environ.get("DOCMD_PASSWORD")
        return cls(
            include_images=not args.no_images,
            use_ocr=not args.no_ocr,
            password=password,
            verify=args.verify,
            quiet=args.quiet,
            stdout=args.stdout,
            jobs=max(1, args.jobs),
            sanitize=not args.no_sanitize,
        )


def _env_budget(name: str, default: int) -> int:
    raw = os.environ.get(name)
    if raw is None or not raw.strip():
        return default
    try:
        value = int(raw)
    except ValueError as exc:
        raise ValueError(f"invalid {name} {raw!r}: expected a positive integer") from exc
    if value <= 0:
        raise ValueError(f"invalid {name} {raw!r}: expected a positive integer")
    return value


class OcrConfig:
    VALID_DEVICES = ("auto", "cpu", "gpu", "npu")
    VALID_MODELS = ("tiny", "small")

    def __init__(
        self,
        device: str = "auto",
        model: str = "tiny",
        threads: int | None = None,
        confidence: float | None = None,
    ) -> None:
        self.device = device
        self.model = model
        self.confidence = 0.5 if confidence is None else confidence
        self.compiled_device = ""
        self.threads = (
            min(4, os.cpu_count() or 1)
            if threads is None or threads <= 0
            else threads
        )

    @classmethod
    def from_env(cls) -> "OcrConfig":
        device = os.environ.get("DOCMD_OCR_DEVICE", "auto").strip().lower()
        model = os.environ.get("DOCMD_OCR_MODEL", "tiny").strip().lower()
        if device not in cls.VALID_DEVICES:
            raise ValueError(
                f"invalid DOCMD_OCR_DEVICE {device!r}; "
                f"accepted values: {', '.join(cls.VALID_DEVICES)}"
            )
        if model not in cls.VALID_MODELS:
            raise ValueError(
                f"invalid DOCMD_OCR_MODEL {model!r}; "
                f"accepted values: {', '.join(cls.VALID_MODELS)}"
            )
        env_threads = os.environ.get("DOCMD_OCR_THREADS")
        threads = None
        if env_threads is not None and env_threads.strip():
            try:
                threads = int(env_threads)
            except ValueError as exc:
                raise ValueError(
                    f"invalid DOCMD_OCR_THREADS {env_threads!r}: expected an integer"
                ) from exc
        env_confidence = os.environ.get("DOCMD_OCR_CONFIDENCE")
        confidence = None
        if env_confidence is not None and env_confidence.strip():
            try:
                confidence = float(env_confidence)
            except ValueError as exc:
                raise ValueError(
                    f"invalid DOCMD_OCR_CONFIDENCE {env_confidence!r}: expected a number"
                ) from exc
            if not 0.0 <= confidence <= 1.0:
                raise ValueError(
                    f"invalid DOCMD_OCR_CONFIDENCE {env_confidence!r}: expected 0.0 to 1.0"
                )
        return cls(
            device=device,
            model=model,
            threads=threads,
            confidence=confidence,
        )

    def device_candidates(self) -> tuple[str, ...]:
        if self.device == "cpu":
            return ()
        if self.device == "gpu":
            return ("GPU",)
        if self.device == "npu":
            return ("NPU",)
        return ("NPU", "GPU")


class DocmdArgumentParser(argparse.ArgumentParser):
    def error(self, message: str) -> None:
        self.print_usage(sys.stderr)
        self.exit(1, f"{self.prog}: error: {message}\n")


def split_table_row(line: str) -> list[str]:
    stripped = line.strip()
    if stripped.startswith("|"):
        stripped = stripped[1:]
    if stripped.endswith("|") and not stripped.endswith(r"\|"):
        stripped = stripped[:-1]

    cells = []
    cell = []
    escaped = False
    code_len = 0
    i = 0
    n = len(stripped)
    while i < n:
        char = stripped[i]
        if escaped:
            cell.append(char)
            escaped = False
            i += 1
        elif char == "\\":
            cell.append(char)
            escaped = True
            i += 1
        elif char == "`":
            run_len = 0
            while i + run_len < n and stripped[i + run_len] == "`":
                run_len += 1
            cell.append("`" * run_len)
            if code_len == 0:
                code_len = run_len
            elif code_len == run_len:
                code_len = 0
            i += run_len
        elif char == "|" and code_len == 0:
            cells.append("".join(cell).strip())
            cell = []
            i += 1
        else:
            cell.append(char)
            i += 1
    cells.append("".join(cell).strip())
    return cells


def is_table_delimiter(line: str) -> bool:
    if "|" not in line:
        return False
    cells = split_table_row(line)
    return bool(cells) and all(
        TABLE_DELIMITER_CELL_RE.fullmatch(cell) for cell in cells
    )


def unquote_markdown_line(line: str) -> str:
    """Strip blockquote markers so quoted tables are checked like top-level ones."""
    stripped = line.lstrip()
    while stripped.startswith(">"):
        stripped = stripped[1:].lstrip()
    return stripped


def fence_info(line: str) -> tuple[str, int, str] | None:
    stripped = line.lstrip()
    if not stripped or stripped[0] not in ("`", "~"):
        return None
    char = stripped[0]
    count = 0
    while count < len(stripped) and stripped[count] == char:
        count += 1
    if count < 3:
        return None
    info = stripped[count:].strip()
    return (char, count, info)


def fence_marker(line: str) -> str | None:
    info = fence_info(line)
    return (info[0] * info[1]) if info is not None else None


def verify_markdown_counts(
    markdown: str, base_dir: Path | None = None
) -> tuple[list[str], dict[str, int]]:
    errors: list[str] = []
    counts = {"fences": 0, "tables": 0, "links": 0, "images": 0}
    fence_state: tuple[str, int] | None = None
    lines = markdown.splitlines()
    index = 0
    while index < len(lines):
        line = lines[index]
        info = fence_info(line)
        if info is not None:
            if fence_state is None:
                fence_state = (info[0], info[1])
                counts["fences"] += 1
            elif fence_state[0] == info[0] and info[1] >= fence_state[1] and not info[2]:
                fence_state = None
            index += 1
            continue
        if fence_state is None and index + 1 < len(lines):
            header = unquote_markdown_line(line)
            delimiter = unquote_markdown_line(lines[index + 1])
            if "|" in header and is_table_delimiter(delimiter):
                header_count = len(split_table_row(header))
                mismatch = len(split_table_row(delimiter)) != header_count
                counts["tables"] += 1
                index += 2
                while index < len(lines):
                    row = unquote_markdown_line(lines[index])
                    if not row.strip() or "|" not in row:
                        break
                    if len(split_table_row(row)) != header_count:
                        mismatch = True
                    index += 1
                if mismatch:
                    errors.append(TABLE_ERROR)
                continue
        index += 1
    if fence_state is not None:
        errors.append("unbalanced code fence")

    asset_lines = []
    fence_state = None
    for line in lines:
        info = fence_info(line)
        if info is not None:
            if fence_state is None:
                fence_state = (info[0], info[1])
            elif fence_state[0] == info[0] and info[1] >= fence_state[1] and not info[2]:
                fence_state = None
            continue
        if fence_state is None:
            asset_lines.append(line)

    base = (Path.cwd() if base_dir is None else Path(base_dir)).resolve()

    def check_target(target: str) -> None:
        target = target.strip()
        if not target or target.startswith("#"):
            return
        lowered = target.lower()
        if lowered.startswith(
            ("http://", "https://", "mailto:", "data:", "file:", "//")
        ):
            return
        link = target.split("#", 1)[0].split("?", 1)[0]
        if not link:
            return
        resolved = (base / unquote(link)).resolve()
        if not resolved.is_relative_to(base):
            errors.append(f"missing asset: {target}")
            return
        if not resolved.is_file():
            errors.append(f"missing asset: {target}")
        elif resolved.stat().st_size == 0:
            errors.append(f"zero-byte asset: {target}")

    for line in asset_lines:
        match = LINK_RE.search(line)
        while match is not None:
            target = (match.group(1) or match.group(2) or "").strip()
            if match.group(0).lstrip().startswith("!"):
                counts["images"] += 1
            else:
                counts["links"] += 1
            check_target(target)
            match = LINK_RE.search(line, match.end())

    for match in HTML_IMAGE_RE.finditer("\n".join(asset_lines)):
        target = (match.group(1) or match.group(2) or match.group(3) or "").strip()
        counts["images"] += 1
        check_target(target)

    for line in asset_lines:
        stripped = unquote_markdown_line(line)
        match = REFERENCE_DEF_RE.match(stripped)
        if match is None:
            continue
        target = match.group(2).strip()
        if target.startswith("<") and ">" in target:
            target = target[1 : target.index(">")]
        else:
            target = target.split()[0] if target.split() else ""
        counts["links"] += 1
        check_target(target)

    return errors, counts


def verify_markdown(markdown: str, base_dir: Path | None = None) -> list[str]:
    return verify_markdown_counts(markdown, base_dir)[0]


def _accelerator_compile(
    core,
    model,
    compile_model,
    config: OcrConfig,
    disabled: dict[str, bool],
    compile_config: dict | None = None,
):
    candidates = config.device_candidates()
    if not candidates:
        return None
    try:
        available = getattr(core, "available_devices", [])
    except Exception:
        available = []
    for device in candidates:
        if disabled.get(device) or device not in available:
            continue
        try:
            compiled = compile_model(
                core, model, device_name=device, config=compile_config
            )
            config.compiled_device = device
            return compiled
        except Exception:
            disabled[device] = True
    return None


def _build_ocr_engine(config: OcrConfig):
    from openvino import Core
    from rapidocr import RapidOCR
    from rapidocr.utils.typings import EngineType, ModelType, OCRVersion

    original_compile = Core.compile_model
    disabled = {"GPU": False, "NPU": False}

    def patched_compile(self, model, device_name=None, compile_config=None):
        if device_name and str(device_name).upper() != "CPU":
            return original_compile(
                self, model, device_name=device_name, config=compile_config
            )
        compiled = _accelerator_compile(
            self, model, original_compile, config, disabled, compile_config
        )
        if compiled is not None:
            return compiled
        config.compiled_device = "CPU"
        return original_compile(
            self, model, device_name="CPU", config=compile_config
        )

    model_type = ModelType.TINY if config.model == "tiny" else ModelType.SMALL
    params = {
        "Det.engine_type": EngineType.OPENVINO,
        "Det.ocr_version": OCRVersion.PPOCRV6,
        "Det.model_type": model_type,
        "Rec.engine_type": EngineType.OPENVINO,
        "Rec.ocr_version": OCRVersion.PPOCRV6,
        "Rec.model_type": model_type,
        "Cls.engine_type": EngineType.OPENVINO,
        "Global.log_level": "error",
    }
    if config.threads > 0:
        params["EngineConfig.openvino.inference_num_threads"] = config.threads

    Core.compile_model = patched_compile
    try:
        engine = RapidOCR(params=params)
        if hasattr(engine, "_load_det_model"):
            engine._load_det_model()
        if hasattr(engine, "_load_rec_model"):
            engine._load_rec_model()
        return engine
    finally:
        Core.compile_model = original_compile


class OcrEngine:
    def __init__(self, config: OcrConfig | None = None) -> None:
        self.config = config or OcrConfig.from_env()
        self._engine = None
        self._layout_engine = None
        self._lock = threading.Lock()
        self.dropped_blocks = 0

    def ensure_loaded(self) -> None:
        with self._lock:
            if self._engine is None:
                self._engine = _build_ocr_engine(self.config)
                log_info(
                    "ocr: compiled on "
                    f"{self.config.compiled_device or 'CPU'} "
                    f"({self.config.model} model)"
                )

    def __call__(self, data):
        with self._lock:
            if self._engine is None:
                self._engine = _build_ocr_engine(self.config)
                log_info(
                    "ocr: compiled on "
                    f"{self.config.compiled_device or 'CPU'} "
                    f"({self.config.model} model)"
                )
            return self._engine(data)

    def record_dropped(self, count: int = 1) -> None:
        if count > 0:
            with self._lock:
                self.dropped_blocks += count

    def layout(self, data: bytes):
        with self._lock:
            if self._layout_engine is None:
                from rapid_layout import RapidLayout

                self._layout_engine = RapidLayout()
            return self._layout_engine(data)


def load_ocr_engine(config: OcrConfig | None = None) -> OcrEngine:
    return OcrEngine(config)


class LayoutEngine:
    def __init__(self) -> None:
        self._engine = None
        self._lock = threading.Lock()

    def __call__(self, data: bytes):
        with self._lock:
            if self._engine is None:
                from rapid_layout import RapidLayout

                self._engine = RapidLayout()
            return self._engine(data)


def load_layout_engine() -> LayoutEngine:
    return LayoutEngine()


class OcrCache(dict):
    def __init__(self, *args, **kwargs) -> None:
        super().__init__(*args, **kwargs)
        self._lock = threading.Lock()

    def get_or_set(self, key: str, func) -> str:
        with self._lock:
            if key in self:
                return self[key]
            if len(self) >= 1000:
                self.clear()
        val = func()
        with self._lock:
            self[key] = val
            return val


def open_office_source(source: Path, password: str | None, opener):
    import msoffcrypto
    from msoffcrypto.exceptions import FileFormatError

    try:
        with source.open("rb") as handle:
            try:
                office = msoffcrypto.OfficeFile(handle)
            except FileFormatError:
                office = None
            if office is not None and office.is_encrypted():
                if not password:
                    raise EncryptedDocumentError(f"encrypted document: {source}")
                try:
                    office.load_key(password=password)
                    decrypted = BytesIO()
                    office.decrypt(decrypted)
                except Exception as exc:
                    raise EncryptedDocumentError(f"invalid password: {source}") from exc
                decrypted.seek(0)
                return opener(decrypted)
            handle.seek(0)
            return opener(handle)
    except EncryptedDocumentError:
        raise
    except (FileNotFoundError, PermissionError):
        raise
    except Exception as exc:
        raise CorruptDocumentError(f"corrupt document: {source}") from exc


def open_pdf(source: Path, password: str | None = None):
    import pymupdf

    if not source.exists():
        raise FileNotFoundError(f"file not found: {source}")
    try:
        with source.open("rb"):
            pass
    except (PermissionError, OSError):
        raise

    try:
        document = pymupdf.open(source)
    except (pymupdf.EmptyFileError, pymupdf.FileDataError, ValueError) as exc:
        raise CorruptDocumentError(f"corrupt document: {source}") from exc
    if document.needs_pass:
        if not password or not document.authenticate(password):
            document.close()
            raise EncryptedDocumentError(f"encrypted document: {source}")
    return document


def build_parser() -> argparse.ArgumentParser:
    parser = DocmdArgumentParser(
        prog="docmd",
        description="Convert Office documents and PDFs to GitHub Flavored Markdown.",
    )
    parser.add_argument("input_path", metavar="INPUT", help="Input document or directory.")
    parser.add_argument(
        "-o",
        "--out",
        metavar="PATH",
        default="./out",
        help="Output file or directory (default: ./out/).",
    )
    parser.add_argument("--stdout", action="store_true", help="Write Markdown to stdout.")
    parser.add_argument("--no-images", action="store_true", help="Omit extracted images.")
    parser.add_argument("--no-ocr", action="store_true", help="Disable OCR.")
    parser.add_argument(
        "--no-sanitize",
        action="store_true",
        help="Disable typography normalisation.",
    )
    parser.add_argument("--password", metavar="SECRET", help="Password for encrypted documents.")
    parser.add_argument("--verify", action="store_true", help="Verify generated Markdown.")
    parser.add_argument(
        "-j",
        "--jobs",
        type=int,
        default=2,
        metavar="N",
        help="Maximum concurrent documents for directory input (default: 2).",
    )
    parser.add_argument("-q", "--quiet", action="store_true", help="Suppress progress logs.")
    parser.add_argument(
        "-v",
        "--version",
        action="version",
        version=f"%(prog)s {VERSION}",
        help="Show version information.",
    )
    return parser


def markdown_table(rows: list[list[str]]) -> list[str]:
    width = max((len(row) for row in rows), default=0)
    if width == 0:
        return []

    normalized = []
    for row in rows:
        cells = [
            cell.replace("\r\n", "\n")
            .replace("\r", "\n")
            .replace("\n", "<br>")
            .replace("\v", "<br>")
            .replace("|", "\\|")
            .strip()
            for cell in row
        ]
        normalized.append(cells + [""] * (width - len(cells)))

    header = "| " + " | ".join(normalized[0]) + " |"
    separator = "| " + " | ".join("---" for _ in range(width)) + " |"
    return [header, separator, *("| " + " | ".join(row) + " |" for row in normalized[1:])]


def pptx_table_rows(table) -> list[list[str]]:
    rows: list[list[str]] = []
    for row_index in range(len(table.rows)):
        row: list[str] = []
        for column_index in range(len(table.columns)):
            cell = table.cell(row_index, column_index)
            text = "" if cell.is_spanned else cell.text
            row.append(text)
        rows.append(row)
    return rows


def convert_docx(source: Path, include_images: bool, password: str | None = None) -> str:
    from docx import Document
    from docx.oxml.ns import qn
    from docx.table import Table
    from docx.text.paragraph import Paragraph

    document = open_office_source(source, password, Document)
    content = list(document.iter_inner_content())
    paragraphs = [block for block in content if isinstance(block, Paragraph)]

    def style_size(style) -> float | None:
        seen = set()
        while style is not None and id(style) not in seen:
            seen.add(id(style))
            if style.font.size is not None:
                return style.font.size.pt
            style = style.base_style
        return None

    def run_size(run, paragraph) -> float | None:
        if run.font.size is not None:
            return run.font.size.pt
        return style_size(paragraph.style)

    def is_bold(paragraph) -> bool:
        runs = [run for run in paragraph.runs if run.text.strip()]
        if not runs:
            return False
        for run in runs:
            bold = run.bold
            if bold is None:
                style = paragraph.style
                seen = set()
                while (
                    style is not None
                    and id(style) not in seen
                    and style.font.bold is None
                ):
                    seen.add(id(style))
                    style = style.base_style
                bold = style.font.bold if style is not None else None
            if not bold:
                return False
        return True

    def paragraph_size(paragraph) -> float | None:
        sizes = []
        for run in paragraph.runs:
            if not run.text.strip():
                continue
            size = run_size(run, paragraph)
            if size is not None:
                sizes.append(size)
        return max(sizes) if sizes else None

    def is_list(paragraph) -> bool:
        name = getattr(getattr(paragraph, "style", None), "name", None) or ""
        style = name.lower()
        return style.startswith("list bullet") or style.startswith("list number")

    def heading_level(paragraph) -> int | None:
        name = getattr(getattr(paragraph, "style", None), "name", None) or ""
        style = name.lower()
        if not style.startswith("heading "):
            return None
        try:
            return min(max(int(style.split()[-1]), 1), 6)
        except ValueError:
            return None

    body_sizes = []
    for paragraph in paragraphs:
        if heading_level(paragraph) is not None or is_bold(paragraph):
            continue
        size = paragraph_size(paragraph)
        if size is not None:
            body_sizes.append(size)
    if body_sizes:
        body_size = max(set(body_sizes), key=body_sizes.count)
    else:
        try:
            body_size = style_size(document.styles["Normal"]) or 11.0
        except KeyError:
            body_size = 11.0

    heading_sizes: dict[float, int] = {}
    for level in range(1, 7):
        try:
            size = style_size(document.styles[f"Heading {level}"])
            if size is not None:
                heading_sizes.setdefault(size, level)
        except KeyError:
            pass

    promoted_sizes = []
    for paragraph in paragraphs:
        if heading_level(paragraph) is not None or is_list(paragraph):
            continue
        size = paragraph_size(paragraph)
        if size is not None and size > body_size + 0.5 and is_bold(paragraph):
            promoted_sizes.append(size)

    promoted_levels: dict[float, int] = {}
    next_level = 1
    for size in sorted(set(promoted_sizes), reverse=True):
        level = heading_sizes.get(size)
        if level is None:
            level = min(next_level, 6)
            next_level += 1
        promoted_levels[size] = level

    from docx.oxml import parse_xml
    from docx.text.run import Run

    footnote_texts: dict[str, str] = {}
    endnote_texts: dict[str, str] = {}

    def load_notes(part_name: str, target: dict[str, str]) -> None:
        for part in document.part.package.iter_parts():
            if str(part.partname) != part_name:
                continue
            try:
                root = parse_xml(part.blob)
            except Exception:
                return
            for kind in ("footnote", "endnote"):
                for note in root.findall(qn(f"w:{kind}")):
                    note_id = note.get(qn("w:id"))
                    text = " ".join(
                        node.text or "" for node in note.iter(qn("w:t"))
                    ).strip()
                    if note_id and text:
                        target[str(note_id)] = text
            return

    load_notes("/word/footnotes.xml", footnote_texts)
    load_notes("/word/endnotes.xml", endnote_texts)
    used_notes: list[tuple[int, str]] = []
    note_numbers: dict[tuple[str, str], int] = {}

    def note_marker(kind: str, note_id: str) -> str:
        key = (kind, note_id)
        if key not in note_numbers:
            number = len(note_numbers) + 1
            note_numbers[key] = number
            source = footnote_texts if kind == "footnote" else endnote_texts
            used_notes.append((number, source[note_id]))
        return f"[^{note_numbers[key]}]"

    numbering: dict[tuple[str, int], tuple[str, int]] = {}
    try:
        numbering_root = document.part.numbering_part.element
        abstract_levels: dict[str, dict[int, tuple[str, int]]] = {}
        for abstract in numbering_root.findall(qn("w:abstractNum")):
            abstract_id = abstract.get(qn("w:abstractNumId"))
            levels: dict[int, tuple[str, int]] = {}
            for level in abstract.findall(qn("w:lvl")):
                level_id = int(level.get(qn("w:ilvl")) or 0)
                fmt_element = level.find(qn("w:numFmt"))
                start_element = level.find(qn("w:start"))
                fmt = (
                    fmt_element.get(qn("w:val"))
                    if fmt_element is not None
                    else "decimal"
                )
                start = int(start_element.get(qn("w:val")) or 1) if start_element is not None else 1
                levels[level_id] = (fmt or "decimal", start)
            if abstract_id is not None:
                abstract_levels[str(abstract_id)] = levels
        for num in numbering_root.findall(qn("w:num")):
            num_id = num.get(qn("w:numId"))
            reference = num.find(qn("w:abstractNumId"))
            if num_id is None or reference is None:
                continue
            levels = abstract_levels.get(str(reference.get(qn("w:val"))), {})
            for level_id, (fmt, start) in levels.items():
                numbering[(str(num_id), level_id)] = (fmt, start)
    except Exception:
        numbering = {}

    def list_info(paragraph) -> tuple[str | None, int, str, int] | None:
        style_name = getattr(getattr(paragraph, "style", None), "name", None) or ""
        style_lower = style_name.lower()
        num_id: str | None = None
        level_id = 0
        p_pr = paragraph._p.pPr
        num_pr = p_pr.numPr if p_pr is not None else None
        if num_pr is not None:
            if num_pr.numId is not None:
                num_id = str(num_pr.numId.val)
            if num_pr.ilvl is not None:
                level_id = int(num_pr.ilvl.val)
        if num_id is not None:
            fmt, start = numbering.get((num_id, level_id), ("decimal", 1))
            return num_id, level_id, fmt, start
        if style_lower.startswith("list bullet"):
            return None, 0, "bullet", 1
        if style_lower.startswith("list number"):
            return None, 0, "decimal", 1
        return None

    def format_run(run) -> str:
        text = run.text
        if not text or not text.strip():
            return text
        name = (run.font.name or "").lower()
        if any(token in name for token in ("consol", "courier", "mono", "code", "menlo")):
            fence = "``" if "`" in text else "`"
            text = f"{fence}{text}{fence}"
        if run.italic:
            text = f"*{text}*"
        if run.bold:
            text = f"**{text}**"
        if run.font.strike:
            text = f"~~{text}~~"
        return text

    def paragraph_markdown(paragraph) -> str:
        parts: list[str] = []
        for child in paragraph._p.iterchildren():
            if child.tag == qn("w:r"):
                parts.append(format_run(Run(child, paragraph)))
                for kind, reference_tag in (
                    ("footnote", "w:footnoteReference"),
                    ("endnote", "w:endnoteReference"),
                ):
                    for reference in child.iter(qn(reference_tag)):
                        note_id = reference.get(qn("w:id"))
                        source = (
                            footnote_texts if kind == "footnote" else endnote_texts
                        )
                        if note_id and str(note_id) in source:
                            parts.append(note_marker(kind, str(note_id)))
            elif child.tag == qn("w:hyperlink"):
                relation_id = child.get(qn("r:id"))
                target = None
                if relation_id:
                    relation = document.part.rels.get(relation_id)
                    target = getattr(relation, "target_ref", None)
                link_text = "".join(
                    node.text or "" for node in child.iter(qn("w:t"))
                )
                if link_text:
                    parts.append(
                        f"[{link_text}]({target})" if target else link_text
                    )
            elif child.tag == qn("w:ins"):
                for run_element in child.iter(qn("w:r")):
                    parts.append(format_run(Run(run_element, paragraph)))
                    for kind, reference_tag in (
                        ("footnote", "w:footnoteReference"),
                        ("endnote", "w:endnoteReference"),
                    ):
                        for reference in run_element.iter(qn(reference_tag)):
                            note_id = reference.get(qn("w:id"))
                            source = (
                                footnote_texts
                                if kind == "footnote"
                                else endnote_texts
                            )
                            if note_id and str(note_id) in source:
                                parts.append(note_marker(kind, str(note_id)))
        return "".join(parts).strip()

    def append_images(element, target: list[str]) -> None:
        if not include_images:
            return
        seen: set[str] = set()
        for blip in element.xpath(".//a:blip"):
            relation_id = blip.get(qn("r:embed"))
            if (
                relation_id is None
                or relation_id in seen
                or relation_id not in document.part.related_parts
            ):
                continue
            seen.add(relation_id)
            image = document.part.related_parts[relation_id]
            if not getattr(image, "blob", None):
                continue
            encoded = base64.b64encode(image.blob).decode("ascii")
            target.append(f"![](data:{image.content_type};base64,{encoded})")

    def table_rows(table) -> list[list[str]]:
        rows: list[list[str]] = []
        for row in table.rows:
            values: list[str] = []
            previous = None
            for cell in row.cells:
                text = cell.text
                tc_pr = cell._tc.tcPr
                if tc_pr is not None:
                    vertical = tc_pr.find(qn("w:vMerge"))
                    if vertical is not None and vertical.get(qn("w:val")) != "restart":
                        text = ""
                if cell._tc is previous:
                    text = ""
                previous = cell._tc
                values.append(text)
            rows.append(values)
        return rows

    blocks: list[str] = []
    list_counters: dict[tuple[str, int], int] = {}
    for block in content:
        if isinstance(block, Paragraph):
            text = block.text.strip()
            markdown_text = paragraph_markdown(block)
            info = list_info(block)
            if text or markdown_text:
                level = heading_level(block)
                if level is None and info is None:
                    size = paragraph_size(block)
                    if size is not None and is_bold(block):
                        level = promoted_levels.get(size)
                if level is not None:
                    blocks.append(f"{'#' * level} {text}")
                    list_counters.clear()
                elif info is not None:
                    num_id, level_id, fmt, start = info
                    key = (num_id or "style", level_id)
                    if fmt == "bullet":
                        marker = "-"
                    else:
                        if key not in list_counters:
                            list_counters[key] = start - 1
                        list_counters[key] += 1
                        marker = f"{list_counters[key]}."
                    blocks.append(
                        f"{'  ' * level_id}{marker} {markdown_text or text}"
                    )
                else:
                    blocks.append(markdown_text or text)
                    list_counters.clear()
            append_images(block._p, blocks)
        elif isinstance(block, Table):
            table = markdown_table(table_rows(block))
            if table:
                blocks.append("\n".join(table))
            append_images(block._tbl, blocks)

    if used_notes:
        blocks.append(
            "\n".join(f"[^{number}]: {text}" for number, text in used_notes)
        )

    return "\n\n".join(blocks) + ("\n" if blocks else "")


def convert_pptx(source: Path, include_images: bool, password: str | None = None) -> str:
    from pptx import Presentation
    from pptx.enum.shapes import MSO_SHAPE_TYPE

    presentation = open_office_source(source, password, Presentation)
    slides = list(presentation.slides)
    blocks: list[str] = []

    def collect_shapes(shape_list):
        items = []
        for shp in shape_list:
            if (
                getattr(shp, "shape_type", None) == MSO_SHAPE_TYPE.GROUP
                and hasattr(shp, "shapes")
            ):
                items.extend(collect_shapes(shp.shapes))
            else:
                items.append(shp)
        return items

    def shape_box(shape):
        top = getattr(shape, "top", None)
        left = getattr(shape, "left", None)
        width = getattr(shape, "width", None)
        height = getattr(shape, "height", None)
        top = 0 if top is None else int(top)
        left = 0 if left is None else int(left)
        width = 0 if width is None else int(width)
        height = 0 if height is None else int(height)
        return top, left, top + height, left + width

    def visual_order(shapes):
        band = 228_600  # a quarter inch in EMU
        return sorted(
            shapes,
            key=lambda shape: (
                shape_box(shape)[0] // band,
                shape_box(shape)[1],
            ),
        )

    def format_pptx_run(run) -> str:
        text = run.text
        if not text or not text.strip():
            return text
        if run.font.name and any(
            token in run.font.name.lower()
            for token in ("consol", "courier", "mono", "code", "menlo")
        ):
            text = f"`{text}`"
        if run.font.italic:
            text = f"*{text}*"
        if run.font.bold:
            text = f"**{text}**"
        return text

    def text_frame_blocks(text_frame) -> list[str]:
        lines: list[str] = []
        for paragraph in text_frame.paragraphs:
            text = "".join(format_pptx_run(run) for run in paragraph.runs).strip()
            if not text:
                continue
            level = max(0, int(getattr(paragraph, "level", 0) or 0))
            bullet = False
            p_pr = getattr(paragraph._p, "pPr", None)
            if p_pr is not None:
                bullet = bool(
                    p_pr.find("{http://schemas.openxmlformats.org/drawingml/2006/main}buChar")
                    is not None
                    or p_pr.find("{http://schemas.openxmlformats.org/drawingml/2006/main}buAutoNum")
                    is not None
                )
            if level > 0 or bullet:
                lines.append(f"{'  ' * level}- {text}")
            else:
                lines.append(text)
        return lines

    def chart_table(chart) -> list[str]:
        try:
            plot = chart.plots[0]
            categories = [str(category) for category in plot.categories]
            series = list(plot.series)
        except (AttributeError, IndexError, ValueError):
            return []
        if not series:
            return []
        rows = [["Category", *[str(s.name or f"Series {i}") for i, s in enumerate(series, 1)]]]
        for index, category in enumerate(categories):
            values = []
            for item in series:
                try:
                    value = item.values[index]
                except (IndexError, TypeError):
                    value = ""
                if value is None:
                    values.append("")
                elif isinstance(value, float) and value.is_integer():
                    values.append(str(int(value)))
                else:
                    values.append(str(value))
            rows.append([category, *values])
        return markdown_table(rows)

    def smartart_text(shape) -> list[str]:
        element = getattr(shape, "element", None)
        if element is None:
            return []
        texts = [node.text or "" for node in element.iter() if node.tag.endswith("}t")]
        return [text.strip() for text in texts if text.strip()]

    for index, slide in enumerate(slides, 1):
        title_shape = slide.shapes.title
        title = title_shape.text.strip() if title_shape is not None else ""
        heading = f"## Slide {index}"
        if title:
            heading += f": {title}"
        blocks.append(heading)

        ordered_shapes = visual_order(list(slide.shapes))
        for top_shape in ordered_shapes:
            for shape in collect_shapes([top_shape]):
                if title_shape is not None and shape.shape_id == title_shape.shape_id:
                    continue
                handled = False
                if getattr(shape, "has_text_frame", False):
                    text_lines = text_frame_blocks(shape.text_frame)
                    if text_lines:
                        blocks.append("\n".join(text_lines))
                        handled = True
                if getattr(shape, "has_table", False):
                    table = markdown_table(pptx_table_rows(shape.table))
                    if table:
                        blocks.append("\n".join(table))
                        handled = True
                if getattr(shape, "has_chart", False):
                    table = chart_table(shape.chart)
                    if table:
                        blocks.append("\n".join(table))
                        handled = True
                smartart = smartart_text(shape)
                if (
                    smartart
                    and not getattr(shape, "has_text_frame", False)
                    and not getattr(shape, "has_table", False)
                    and not getattr(shape, "has_chart", False)
                ):
                    blocks.append("\n".join(f"- {text}" for text in smartart))
                    handled = True
                if (
                    include_images
                    and getattr(shape, "shape_type", None) == MSO_SHAPE_TYPE.PICTURE
                ):
                    try:
                        image = shape.image
                    except (KeyError, ValueError):
                        image = None
                    if image is not None and getattr(image, "blob", None):
                        extension = (image.ext or "").lower()
                        mime_type = image.content_type or IMAGE_MIME_TYPES.get(
                            extension,
                            f"image/{extension}" if extension else "image/png",
                        )
                        encoded = base64.b64encode(image.blob).decode("ascii")
                        blocks.append(f"![](data:{mime_type};base64,{encoded})")
                    handled = True
                shape_type = getattr(shape, "shape_type", None)
                safe_types = {
                    MSO_SHAPE_TYPE.AUTO_SHAPE,
                    MSO_SHAPE_TYPE.TEXT_BOX,
                    MSO_SHAPE_TYPE.PLACEHOLDER,
                    MSO_SHAPE_TYPE.PICTURE,
                    MSO_SHAPE_TYPE.LINE,
                    MSO_SHAPE_TYPE.FREEFORM,
                    None,
                }
                if not handled and shape_type not in safe_types:
                    type_name = getattr(shape_type, "name", str(shape_type))
                    blocks.append(
                        f"<!-- docmd: omitted {type_name} shape on slide {index} -->"
                    )

        if slide.has_notes_slide:
            notes_frame = getattr(slide.notes_slide, "notes_text_frame", None)
            notes = notes_frame.text.strip() if notes_frame is not None else ""
            if notes:
                note_lines = notes.splitlines()
                quoted = [f"> **Speaker Notes:** {note_lines[0]}"]
                quoted.extend(f"> {line}" for line in note_lines[1:])
                blocks.append("\n".join(quoted))
        if index < len(slides):
            blocks.append("---")

    return "\n\n".join(blocks) + ("\n" if blocks else "")


def extract_pdf_spans(source: Path, password: str | None = None) -> list[dict[str, object]]:
    document = open_pdf(source, password)
    spans: list[dict[str, object]] = []
    try:
        for page in document:
            for block in page.get_text("dict").get("blocks", []):
                for line in block.get("lines", []):
                    for span in line.get("spans", []):
                        spans.append(
                            {
                                "text": span["text"],
                                "size": span["size"],
                                "bbox": span["bbox"],
                                "page": page.number,
                            }
                        )
    finally:
        document.close()
    return spans


def order_pdf_lines(
    lines: list[dict[str, object]],
    page_width: float,
) -> list[dict[str, object]]:
    if len(lines) < 2:
        return lines

    gap = max(24.0, page_width * 0.1)
    ordered = sorted(lines, key=lambda line: line["bbox"][0])
    clusters: list[list[dict[str, object]]] = []
    for line in ordered:
        x0 = line["bbox"][0]
        if not clusters or x0 - clusters[-1][-1]["bbox"][0] > gap:
            clusters.append([line])
        else:
            clusters[-1].append(line)

    merged: list[list[dict[str, object]]] = []
    for cluster in clusters:
        if merged:
            previous_x1 = max(line["bbox"][2] for line in merged[-1])
            cluster_x0 = min(line["bbox"][0] for line in cluster)
            if cluster_x0 < previous_x1:
                merged[-1].extend(cluster)
                continue
        merged.append(cluster)

    if len(merged) < 2:
        return sorted(lines, key=lambda line: (line["bbox"][1], line["bbox"][0]))

    ordered_lines: list[dict[str, object]] = []
    for cluster in sorted(merged, key=lambda group: min(line["bbox"][0] for line in group)):
        ordered_lines.extend(
            sorted(cluster, key=lambda line: (line["bbox"][1], line["bbox"][0]))
        )
    return ordered_lines


def ocr_items(engine, data):
    result = engine(data)
    if isinstance(result, tuple):
        yield from result[0] or []
        return
    boxes = getattr(result, "boxes", None)
    texts = getattr(result, "txts", None) or ()
    scores = getattr(result, "scores", None) or ()
    if boxes is None:
        return
    yield from zip(boxes, texts, scores)


def normalize_text(text: str) -> str:
    normalized = unicodedata.normalize("NFKC", text).casefold()
    return " ".join(re.findall(r"[a-z0-9]+", normalized))


def token_similarity(left: str, right: str) -> float:
    a = set(normalize_text(left).split())
    b = set(normalize_text(right).split())
    if not a or not b:
        return 0.0
    return len(a & b) / min(len(a), len(b))


def text_matches(left: str, right: str, threshold: float = 0.8) -> bool:
    na = normalize_text(left)
    nb = normalize_text(right)
    if not na or not nb:
        return False
    if na == nb:
        return True
    if min(len(na), len(nb)) >= 4 and (na in nb or nb in na):
        return True
    return token_similarity(left, right) >= threshold


def matches_any(text: str, candidates: list[str], threshold: float = 0.8) -> bool:
    return any(text_matches(text, candidate, threshold) for candidate in candidates)


def page_image_coverage(page) -> float:
    page_area = max(1.0, page.rect.width * page.rect.height)
    largest = 0.0
    try:
        infos = page.get_image_info()
    except Exception:
        return 0.0
    for info in infos:
        bbox = info.get("bbox")
        if not bbox:
            continue
        area = max(0.0, bbox[2] - bbox[0]) * max(0.0, bbox[3] - bbox[1])
        largest = max(largest, area)
    return largest / page_area


def ocr_confidence_threshold(engine) -> float:
    config = getattr(engine, "config", None)
    value = getattr(config, "confidence", 0.5)
    return 0.5 if value is None else float(value)


def ocr_pdf_page(
    page,
    engine,
    digital_texts: list[str] | None = None,
    max_image_pixels: int | None = None,
) -> list[dict[str, object]] | None:
    if hasattr(engine, "ensure_loaded"):
        engine.ensure_loaded()
    try:
        pixmap = page.get_pixmap(dpi=200)
    except Exception as exc:
        log_warning(f"OCR failed for page {page.number + 1}: {exc}")
        return None
    if not pixmap or pixmap.width <= 0 or pixmap.height <= 0:
        return None
    if max_image_pixels is not None and pixmap.width * pixmap.height > max_image_pixels:
        raise BudgetError(
            f"image budget exceeded for page {page.number + 1}: "
            f"{pixmap.width * pixmap.height} pixels (limit {max_image_pixels})"
        )
    scale_x = page.rect.width / pixmap.width
    scale_y = page.rect.height / pixmap.height
    threshold = ocr_confidence_threshold(engine)
    digital_texts = digital_texts or []

    lines: list[dict[str, object]] = []
    try:
        items = list(ocr_items(engine, pixmap.tobytes("png")))
    except Exception as exc:
        log_warning(f"OCR failed for page {page.number + 1}: {exc}")
        return None
    for item in items:
        box, text, score = item
        text = text.strip()
        if not text or score is None or math.isnan(score) or score < threshold:
            if hasattr(engine, "record_dropped"):
                engine.record_dropped()
            continue
        if len(text) <= 2 and not matches_any(text, digital_texts):
            if hasattr(engine, "record_dropped"):
                engine.record_dropped()
            continue
        xs = [point[0] for point in box]
        ys = [point[1] for point in box]
        bbox = (
            min(xs) * scale_x,
            min(ys) * scale_y,
            max(xs) * scale_x,
            max(ys) * scale_y,
        )
        lines.append(
            {
                "text": text,
                "size": round(bbox[3] - bbox[1], 1),
                "bbox": bbox,
                "page": page.number,
                "page_height": page.rect.height,
                "page_width": page.rect.width,
                "ocr": True,
                "confidence": float(score),
            }
        )
    return lines


def extract_layout_blocks(engine, image: bytes) -> list[dict[str, object]]:
    """Extract layout blocks using RapidLayout if available."""
    if engine is None:
        return []
    layout_fn = getattr(engine, "layout", None) or (engine if callable(engine) else None)
    if layout_fn is None:
        return []
    try:
        res = layout_fn(image)
        boxes = getattr(res, "boxes", None)
        classes = getattr(res, "class_names", None) or ()
        scores = getattr(res, "scores", None) or ()
        if boxes is None:
            return []
        blocks: list[dict[str, object]] = []
        for box, cls, score in zip(boxes, classes, scores):
            if score is None or math.isnan(score) or score < 0.4:
                continue
            blocks.append(
                {
                    "bbox": (
                        float(box[0]),
                        float(box[1]),
                        float(box[2]),
                        float(box[3]),
                    ),
                    "class": str(cls),
                    "score": float(score),
                }
            )
        return blocks
    except Exception as exc:
        if not getattr(engine, "_layout_failed", False):
            setattr(engine, "_layout_failed", True)
            log_info(f"layout: unavailable ({exc}); using geometric ordering")
        return []


def order_lines_by_layout(
    lines: list[dict[str, object]],
    page_width: float,
    page_height: float,
    layout_blocks: list[dict[str, object]] | None = None,
) -> list[dict[str, object]]:
    if len(lines) < 2:
        return lines

    if not layout_blocks:
        return order_pdf_lines(lines, page_width)

    block_lines: list[list[dict[str, object]]] = [[] for _ in layout_blocks]
    unassigned: list[dict[str, object]] = []

    for line in lines:
        cx = (line["bbox"][0] + line["bbox"][2]) / 2
        cy = (line["bbox"][1] + line["bbox"][3]) / 2

        matched_idx = None
        min_area = float("inf")

        for idx, block in enumerate(layout_blocks):
            bx0, by0, bx1, by1 = block["bbox"]
            if (bx0 - 5 <= cx <= bx1 + 5) and (by0 - 5 <= cy <= by1 + 5):
                area = max(1.0, (bx1 - bx0) * (by1 - by0))
                if area < min_area:
                    min_area = area
                    matched_idx = idx

        if matched_idx is not None:
            block_lines[matched_idx].append(line)
        else:
            unassigned.append(line)

    def block_key(idx: int):
        block = layout_blocks[idx]
        cls = block.get("class", "text")
        b = block["bbox"]
        priority = 1
        if cls == "header" or (
            b[3] < page_height * 0.15 and (b[2] - b[0]) > page_width * 0.5
        ):
            priority = 0
        elif cls == "footer" or (
            b[1] > page_height * 0.85 and (b[2] - b[0]) > page_width * 0.5
        ):
            priority = 2
        return (priority, round(b[1] / 30), b[0])

    ordered_block_indices = sorted(range(len(layout_blocks)), key=block_key)

    result: list[dict[str, object]] = []
    for idx in ordered_block_indices:
        b_lines = block_lines[idx]
        if not b_lines:
            continue
        bw = layout_blocks[idx]["bbox"][2] - layout_blocks[idx]["bbox"][0]
        result.extend(order_pdf_lines(b_lines, bw))

    if unassigned:
        result.extend(order_pdf_lines(unassigned, page_width))

    return result


def ocr_image_text(engine, image: bytes) -> str:
    if hasattr(engine, "ensure_loaded"):
        engine.ensure_loaded()
    try:
        raw_items = list(ocr_items(engine, image))
    except Exception as exc:
        log_warning(f"OCR failed for image: {exc}")
        return ""
    threshold = ocr_confidence_threshold(engine)
    lines: list[dict[str, object]] = []
    for item in raw_items:
        box, text, score = item
        text = text.strip()
        if not text or score is None or math.isnan(score) or score < threshold:
            if hasattr(engine, "record_dropped"):
                engine.record_dropped()
            continue
        if len(text) <= 2:
            if hasattr(engine, "record_dropped"):
                engine.record_dropped()
            continue
        xs = [point[0] for point in box]
        ys = [point[1] for point in box]
        lines.append(
            {
                "text": text,
                "bbox": (min(xs), min(ys), max(xs), max(ys)),
            }
        )
    if not lines:
        return ""

    max_x = max(line["bbox"][2] for line in lines)
    max_y = max(line["bbox"][3] for line in lines)
    layout_blocks = extract_layout_blocks(engine, image)
    ordered = order_lines_by_layout(
        lines,
        page_width=max_x,
        page_height=max_y,
        layout_blocks=layout_blocks,
    )
    return " ".join(line["text"] for line in ordered)


def _line_link(page_links: list[dict[str, object]], bbox) -> str | None:
    cx = (bbox[0] + bbox[2]) / 2
    cy = (bbox[1] + bbox[3]) / 2
    for link in page_links:
        uri = link.get("uri")
        rect = link.get("from")
        if not uri or rect is None:
            continue
        if (
            rect.x0 - 2 <= cx <= rect.x1 + 2
            and rect.y0 - 2 <= cy <= rect.y1 + 2
        ):
            return str(uri)
    return None


def layout_blocks_for_page(
    page, layout_engine, max_image_pixels: int | None = None
) -> list[dict[str, object]]:
    if layout_engine is None:
        return []
    try:
        pixmap = page.get_pixmap(dpi=150)
        image = pixmap.tobytes("png")
    except Exception as exc:
        log_info(f"layout: page {page.number + 1} unavailable ({exc})")
        return []
    if max_image_pixels is not None and pixmap.width * pixmap.height > max_image_pixels:
        raise BudgetError(
            f"image budget exceeded for page {page.number + 1}: "
            f"{pixmap.width * pixmap.height} pixels (limit {max_image_pixels})"
        )
    blocks = extract_layout_blocks(layout_engine, image)
    if not blocks or pixmap.width <= 0 or pixmap.height <= 0:
        return []
    scale_x = page.rect.width / pixmap.width
    scale_y = page.rect.height / pixmap.height
    return [
        {
            "bbox": (
                block["bbox"][0] * scale_x,
                block["bbox"][1] * scale_y,
                block["bbox"][2] * scale_x,
                block["bbox"][3] * scale_y,
            ),
            "class": block.get("class", "text"),
            "score": block.get("score", 0.0),
        }
        for block in blocks
    ]


def _bbox_contains(outer, inner, tolerance: float = 2.0) -> bool:
    return (
        outer[0] - tolerance <= inner[0]
        and outer[1] - tolerance <= inner[1]
        and inner[2] <= outer[2] + tolerance
        and inner[3] <= outer[3] + tolerance
    )


def detect_pdf_tables(
    lines: list[dict[str, object]],
    page_width: float,
    page_height: float,
    anchor_tolerance: float = 22.0,
    row_gap: float = 8.0,
    min_anchor_lines: int = 3,
    min_multi: int = 3,
    include_ocr: bool = False,
) -> list[dict[str, object]]:
    """Recover simple text tables from aligned x anchors on a PDF page."""
    candidates = [
        line
        for line in lines
        if (include_ocr or not line.get("ocr"))
        and not line.get("ocr_error")
        and not line.get("_in_table")
        and line["bbox"][1] > page_height * 0.07
        and line["bbox"][3] < page_height * 0.94
        and len(str(line["text"]).strip()) > 0
    ]
    if len(candidates) < 6:
        return []

    anchors: list[dict[str, object]] = []
    for line in sorted(candidates, key=lambda item: item["bbox"][0]):
        x = float(line["bbox"][0])
        if anchors and abs(x - float(anchors[-1]["x"])) <= anchor_tolerance:
            anchors[-1]["lines"].append(line)
            anchors[-1]["x"] = (
                float(anchors[-1]["x"]) * (len(anchors[-1]["lines"]) - 1) + x
            ) / len(anchors[-1]["lines"])
        else:
            anchors.append({"x": x, "lines": [line]})
    anchors = [
        anchor for anchor in anchors if len(anchor["lines"]) >= min_anchor_lines
    ]
    if len(anchors) < 2:
        return []

    def nearest_anchor(line) -> int | None:
        x = float(line["bbox"][0])
        best = min(anchors, key=lambda item: abs(float(item["x"]) - x))
        return (
            anchors.index(best)
            if abs(float(best["x"]) - x) <= anchor_tolerance + 4
            else None
        )

    rows: list[dict[str, object]] = []
    for line in sorted(candidates, key=lambda item: (item["bbox"][1], item["bbox"][0])):
        y0, y1 = float(line["bbox"][1]), float(line["bbox"][3])
        placed = False
        for row in reversed(rows[-3:]):
            if (
                y0 <= float(row["y1"]) + row_gap
                and y1 >= float(row["y0"]) - row_gap
            ):
                row["lines"].append(line)
                row["y0"] = min(float(row["y0"]), y0)
                row["y1"] = max(float(row["y1"]), y1)
                placed = True
                break
        if not placed:
            rows.append({"y0": y0, "y1": y1, "lines": [line]})

    for row in rows:
        row["anchors"] = {
            index
            for index in (nearest_anchor(line) for line in row["lines"])
            if index is not None
        }

    merged_rows: list[dict[str, object]] = []
    for row in rows:
        if (
            merged_rows
            and len(row["anchors"]) == 1
            and row["y0"] - float(merged_rows[-1]["y1"]) <= 25
        ):
            merged_rows[-1]["lines"].extend(row["lines"])
            merged_rows[-1]["anchors"] |= row["anchors"]
            merged_rows[-1]["y1"] = max(
                float(merged_rows[-1]["y1"]), float(row["y1"])
            )
            continue
        merged_rows.append(row)

    multi = [index for index, row in enumerate(merged_rows) if len(row["anchors"]) >= 2]
    if len(multi) < min_multi:
        return []

    runs: list[list[int]] = []
    for index in multi:
        if runs and index == runs[-1][-1] + 1:
            runs[-1].append(index)
        else:
            runs.append([index])
    run = max(runs, key=len)
    start, end = run[0], run[-1]
    if end + 1 < len(merged_rows):
        trailing = merged_rows[end + 1]
        if float(trailing["y0"]) - float(merged_rows[end]["y1"]) <= 50:
            end += 1

    table_rows = merged_rows[start : end + 1]
    anchor_counts: dict[int, int] = {}
    for row in table_rows:
        if len(row["anchors"]) >= 2:
            for index in row["anchors"]:
                anchor_counts[index] = anchor_counts.get(index, 0) + 1
    table_anchors = sorted(
        index for index, count in anchor_counts.items() if count >= 2
    )
    if len(table_anchors) < 2 or len(table_rows) < 3:
        return []

    rows_out: list[list[str]] = []
    used_lines: list[dict[str, object]] = []
    for row in table_rows:
        cells: dict[int, list[str]] = {index: [] for index in table_anchors}
        for line in row["lines"]:
            index = nearest_anchor(line)
            if index in cells:
                cells[index].append(str(line["text"]).strip())
                used_lines.append(line)
        if any(cells[index] for index in table_anchors):
            rows_out.append(
                ["<br>".join(cells[index]) for index in table_anchors]
            )
    if len(rows_out) < 3:
        return []

    for line in used_lines:
        line["_in_table"] = True
    boxes = [line["bbox"] for line in used_lines]
    bbox = (
        min(box[0] for box in boxes),
        min(box[1] for box in boxes),
        max(box[2] for box in boxes),
        max(box[3] for box in boxes),
    )
    return [
        {
            "text": "",
            "table": rows_out,
            "bbox": bbox,
            "page": used_lines[0]["page"],
            "page_height": page_height,
            "page_width": page_width,
            "size": 0.0,
        }
    ]


def extract_pdf_lines(
    source: Path,
    password: str | None = None,
    use_ocr: bool = True,
    ocr_engine: OcrEngine | None = None,
    document=None,
    layout_engine=None,
    max_image_pixels: int | None = None,
) -> list[dict[str, object]]:
    if use_ocr and ocr_engine is None:
        ocr_engine = load_ocr_engine()
    if layout_engine is None:
        layout_engine = ocr_engine if hasattr(ocr_engine, "layout") else None
    if layout_engine is None:
        layout_engine = load_layout_engine()
    if use_ocr and ocr_engine is not None and hasattr(ocr_engine, "ensure_loaded"):
        try:
            ocr_engine.ensure_loaded()
        except Exception as exc:
            raise OcrError(f"OCR engine failed to load: {exc}") from exc

    should_close = False
    if document is None:
        document = open_pdf(source, password)
        should_close = True
    lines: list[dict[str, object]] = []
    try:
        for page in document:
            page_lines: list[dict[str, object]] = []
            page_links = page.get_links()
            for block in page.get_text("dict").get("blocks", []):
                for line in block.get("lines", []):
                    spans = line.get("spans", [])
                    text = "".join(span["text"] for span in spans).strip()
                    if not text:
                        continue
                    dominant = max(spans, key=lambda span: len(span["text"]))
                    page_lines.append(
                        {
                            "text": text,
                            "size": round(dominant["size"], 1),
                            "bbox": line["bbox"],
                            "page": page.number,
                            "page_height": page.rect.height,
                            "page_width": page.rect.width,
                            "link": _line_link(page_links, line["bbox"]),
                        }
                    )

            tables = detect_pdf_tables(
                page_lines, page.rect.width, page.rect.height
            )
            page_lines = [line for line in page_lines if not line.get("_in_table")]
            digital_texts = [str(line["text"]) for line in page_lines]
            for table in tables:
                for row in table["table"]:
                    digital_texts.extend(
                        cell.replace("<br>", " ") for cell in row if cell
                    )
            digital_characters = sum(len(text) for text in digital_texts)
            trigger_ocr = use_ocr and ocr_engine is not None and (
                digital_characters < 50 or page_image_coverage(page) > 0.6
            )
            if trigger_ocr:
                ocr_lines = ocr_pdf_page(
                    page,
                    ocr_engine,
                    digital_texts=digital_texts,
                    max_image_pixels=max_image_pixels,
                )
                if ocr_lines is None:
                    page_lines.append(
                        {
                            "text": (
                                f"<!-- OCR failed for page {page.number + 1} -->"
                            ),
                            "size": 0.0,
                            "bbox": (0.0, 0.0, 0.0, 0.0),
                            "page": page.number,
                            "page_height": page.rect.height,
                            "page_width": page.rect.width,
                            "ocr_error": True,
                        }
                    )
                else:
                    for ocr_line in ocr_lines:
                        if not matches_any(str(ocr_line["text"]), digital_texts):
                            page_lines.append(ocr_line)
                    ocr_candidates = [
                        line for line in page_lines if line.get("ocr")
                    ]
                    if len(ocr_candidates) >= 6:
                        ocr_tables = detect_pdf_tables(
                            ocr_candidates,
                            page.rect.width,
                            page.rect.height,
                            anchor_tolerance=8,
                            row_gap=8,
                            min_anchor_lines=2,
                            min_multi=2,
                            include_ocr=True,
                        )
                        if ocr_tables:
                            page_lines = [
                                line
                                for line in page_lines
                                if not line.get("_in_table")
                            ]
                            tables.extend(ocr_tables)
            page_lines.extend(tables)

            blocks = layout_blocks_for_page(
                page, layout_engine, max_image_pixels=max_image_pixels
            )
            if blocks:
                ordered = order_lines_by_layout(
                    page_lines,
                    page_width=page.rect.width,
                    page_height=page.rect.height,
                    layout_blocks=blocks,
                )
            else:
                ordered = order_pdf_lines(page_lines, page.rect.width)
            lines.extend(ordered)
    finally:
        if should_close:
            document.close()
    return lines


def strip_pdf_margins(lines: list[dict[str, object]]) -> list[dict[str, object]]:
    margin = 0.1
    margin_flags: list[bool] = []
    counts: dict[str, int] = {}
    for line in lines:
        height = line["page_height"]
        bbox = line["bbox"]
        in_margin = bbox[1] < height * margin or bbox[3] > height * (1 - margin)
        margin_flags.append(in_margin)
        if in_margin:
            key = " ".join(line["text"].split()).casefold()
            counts[key] = counts.get(key, 0) + 1

    page_number = re.compile(
        r"(?:page\s*)?[-–—]?\s*\d+\s*[-–—]?(?:\s*(?:/|of)\s*\d+)?",
        re.IGNORECASE,
    )
    kept: list[dict[str, object]] = []
    for line, in_margin in zip(lines, margin_flags):
        if line.get("table") or line.get("ocr_error") or not in_margin:
            kept.append(line)
            continue
        text = " ".join(str(line.get("text", "")).split())
        if not text:
            continue
        if counts[text.casefold()] >= 2 or page_number.fullmatch(text):
            continue
        kept.append(line)
    return kept


def pdf_image_blocks(
    source: Path,
    password: str | None = None,
    use_ocr: bool = True,
    ocr_engine: OcrEngine | None = None,
    document=None,
    ocr_cache: dict[str, str] | None = None,
    max_image_pixels: int | None = None,
) -> list[tuple[int, str]]:
    if use_ocr and ocr_engine is None:
        ocr_engine = load_ocr_engine()
    should_close = False
    if document is None:
        document = open_pdf(source, password)
        should_close = True
    if ocr_cache is None:
        ocr_cache = {}
    blocks: list[tuple[int, str]] = []
    try:
        for page in document:
            seen: set[int] = set()
            for image_info in page.get_images(full=True):
                xref = image_info[0]
                if xref <= 0 or xref in seen:
                    continue
                seen.add(xref)
                try:
                    extracted = document.extract_image(xref)
                except Exception:
                    continue
                image = extracted.get("image")
                if not image:
                    continue
                width = int(extracted.get("width") or 0)
                height = int(extracted.get("height") or 0)
                if (
                    max_image_pixels is not None
                    and width > 0
                    and height > 0
                    and width * height > max_image_pixels
                ):
                    raise BudgetError(
                        f"image budget exceeded on page {page.number + 1}: "
                        f"{width * height} pixels (limit {max_image_pixels})"
                    )
                extension = (extracted.get("ext") or "").lower()
                mime_type = IMAGE_MIME_TYPES.get(
                    extension,
                    f"image/{extension}" if extension else "image/png",
                )
                encoded = base64.b64encode(image).decode("ascii")
                blocks.append((page.number, f"![](data:{mime_type};base64,{encoded})"))
                if ocr_engine is not None:
                    digest = hashlib.sha256(image).hexdigest()
                    if hasattr(ocr_cache, "get_or_set"):
                        text = ocr_cache.get_or_set(
                            digest, lambda: ocr_image_text(ocr_engine, image)
                        )
                    else:
                        if digest not in ocr_cache:
                            if len(ocr_cache) >= 1000:
                                ocr_cache.clear()
                            try:
                                ocr_cache[digest] = ocr_image_text(ocr_engine, image)
                            except Exception:
                                ocr_cache[digest] = ""
                        text = ocr_cache[digest]
                    if text:
                        blocks.append((page.number, f"{IMAGE_TEXT_PREFIX}{text}"))
    finally:
        if should_close:
            document.close()
    return blocks


def _pdf_line_gap(previous: dict[str, object], line: dict[str, object]) -> float:
    return float(line["bbox"][1]) - float(previous["bbox"][3])


def _join_pdf_lines(texts: list[str]) -> str:
    result = ""
    for text in texts:
        if not result:
            result = text
            continue
        previous = result.rstrip()
        if (
            previous.endswith("-")
            and text[:1].islower()
            and "://" not in previous
            and "www." not in previous
            and "](" not in previous
            and len(previous.rsplit(None, 1)[-1]) > 2
        ):
            result = previous[:-1] + text
        else:
            result = f"{previous} {text}"
    return result


def _pdf_list_text(text: str) -> str | None:
    match = LIST_ITEM_RE.match(text)
    if match is None:
        return None
    item = text[match.end() :].strip()
    if not item:
        return None
    return f"- {item}"


def _pdf_line_display_text(line: dict[str, object]) -> str:
    text = str(line.get("text", "")).strip()
    link = line.get("link")
    if link and text and "](" not in text:
        return f"[{text}]({link})"
    return text


def merge_linked_pdf_lines(
    lines: list[dict[str, object]],
) -> list[dict[str, object]]:
    """Rejoin a link annotation that PyMuPDF split across adjacent lines."""
    merged: list[dict[str, object]] = []
    for line in lines:
        if merged:
            previous = merged[-1]
            same_link = (
                line.get("link")
                and previous.get("link") == line.get("link")
                and previous.get("page") == line.get("page")
                and not previous.get("table")
                and not line.get("table")
                and not previous.get("ocr_error")
                and not line.get("ocr_error")
            )
            if same_link:
                gap = float(line["bbox"][1]) - float(previous["bbox"][3])
                if gap <= 20:
                    left = str(previous["text"])
                    right = str(line["text"])
                    joiner = "" if "://" in left or "://" in right else " "
                    previous["text"] = left + joiner + right
                    previous["bbox"] = (
                        min(previous["bbox"][0], line["bbox"][0]),
                        min(previous["bbox"][1], line["bbox"][1]),
                        max(previous["bbox"][2], line["bbox"][2]),
                        max(previous["bbox"][3], line["bbox"][3]),
                    )
                    continue
        merged.append(line)
    return merged


def convert_pdf(
    source: Path,
    include_images: bool,
    password: str | None = None,
    use_ocr: bool = True,
    ocr_engine: OcrEngine | None = None,
    ocr_cache: dict[str, str] | None = None,
    layout_engine=None,
    max_pages: int | None = None,
    max_image_pixels: int | None = None,
) -> str:
    if use_ocr and ocr_engine is None:
        ocr_engine = load_ocr_engine()
    if ocr_cache is None:
        ocr_cache = {}
    document = open_pdf(source, password)
    try:
        if max_pages is not None and len(document) > max_pages:
            raise BudgetError(
                f"page budget exceeded for {source}: {len(document)} pages "
                f"(limit {max_pages})"
            )
        lines = merge_linked_pdf_lines(
            strip_pdf_margins(
                extract_pdf_lines(
                    source,
                    password,
                    use_ocr,
                    ocr_engine,
                    document=document,
                    layout_engine=layout_engine,
                    max_image_pixels=max_image_pixels,
                )
            )
        )
        image_entries = (
            pdf_image_blocks(
                source,
                password,
                use_ocr,
                ocr_engine,
                document=document,
                ocr_cache=ocr_cache,
                max_image_pixels=max_image_pixels,
            )
            if include_images
            else []
        )
    finally:
        document.close()

    page_text: dict[object, str] = {}
    for line in lines:
        if line.get("ocr_error"):
            continue
        page_number = line["page"]
        if line.get("table"):
            cells = [
                cell.replace("<br>", " ")
                for row in line["table"]
                for cell in row
            ]
            page_text[page_number] = (
                f"{page_text.get(page_number, '')} {' '.join(cells)}"
            )
            continue
        page_text[page_number] = f"{page_text.get(page_number, '')} {line['text']}"

    size_counts: dict[float, int] = {}
    for line in lines:
        if line.get("table") or line.get("ocr_error"):
            continue
        size = float(line["size"])
        size_counts[size] = size_counts.get(size, 0) + 1
    if not size_counts:
        return "\n\n".join(block for _, block in image_entries) + (
            "\n" if image_entries else ""
        )

    body_size = min(size_counts, key=lambda size: (-size_counts[size], size))
    heading_sizes = sorted(
        (size for size in size_counts if size > body_size + 0.5),
        reverse=True,
    )
    heading_levels = {
        size: min(index, 3) for index, size in enumerate(heading_sizes, 1)
    }
    body_texts = {
        normalize_text(str(line["text"]))
        for line in lines
        if not line.get("table")
        and not line.get("ocr_error")
        and not line.get("ocr")
        and float(line["size"]) <= body_size + 0.5
    }

    images_by_page: dict[int, list[str]] = {}
    for page_number, block in image_entries:
        if block.startswith(IMAGE_TEXT_PREFIX):
            caption = block[len(IMAGE_TEXT_PREFIX) :]
            page_value = page_text.get(page_number, "")
            if caption and (
                " ".join(caption.split()).casefold()
                in " ".join(page_value.split()).casefold()
                or token_similarity(caption, page_value) >= 0.8
            ):
                log_info(
                    f"pdf: suppressed duplicate image text on page {page_number + 1}"
                )
                continue
        images_by_page.setdefault(page_number, []).append(block)

    # Median positive line gap per page drives paragraph breaks.
    page_gaps: dict[object, float] = {}
    for page_number in {line["page"] for line in lines}:
        page_lines = [line for line in lines if line["page"] == page_number]
        gaps = [
            _pdf_line_gap(previous, line)
            for previous, line in zip(page_lines, page_lines[1:])
            if _pdf_line_gap(previous, line) > 1
        ]
        if gaps:
            gaps.sort()
            page_gaps[page_number] = gaps[len(gaps) // 2]

    text_blocks: dict[int, list[str]] = {}
    paragraph: list[str] = []
    current_page: int | None = None
    previous_line: dict[str, object] | None = None

    def flush() -> None:
        nonlocal paragraph
        if paragraph and current_page is not None:
            text_blocks.setdefault(current_page, []).append(_join_pdf_lines(paragraph))
        paragraph = []

    for line in lines:
        if line["page"] != current_page:
            flush()
            current_page = line["page"]
            previous_line = None

        if line.get("table"):
            flush()
            table = markdown_table(line["table"])
            if table:
                text_blocks.setdefault(current_page, []).append("\n".join(table))
            previous_line = line
            continue
        if line.get("ocr_error"):
            flush()
            text_blocks.setdefault(current_page, []).append(str(line["text"]))
            previous_line = line
            continue

        gap = None
        if previous_line is not None:
            gap = _pdf_line_gap(previous_line, line)
        if (
            paragraph
            and gap is not None
            and gap > max(8.0, page_gaps.get(current_page, 12.0) * 1.4)
        ):
            flush()

        text = str(line["text"])
        ocr_line = bool(line.get("ocr"))
        short_enough = len(text.split()) <= 12
        candidate_level = heading_levels.get(float(line["size"]))
        if (
            candidate_level is not None
            and short_enough
            and not ocr_line
            and not LIST_ITEM_RE.match(text)
            and normalize_text(text) not in body_texts
        ):
            flush()
            text_blocks.setdefault(current_page, []).append(
                f"{'#' * candidate_level} {_pdf_line_display_text(line)}"
            )
        else:
            list_text = _pdf_list_text(text)
            if list_text is not None:
                flush()
                text_blocks.setdefault(current_page, []).append(
                    _pdf_line_display_text({**line, "text": list_text})
                )
            else:
                paragraph.append(_pdf_line_display_text(line))
        previous_line = line
    flush()

    blocks: list[str] = []
    for page in sorted(set(text_blocks) | set(images_by_page)):
        blocks.extend(text_blocks.get(page, []))
        blocks.extend(images_by_page.get(page, []))

    if ocr_engine is not None and getattr(ocr_engine, "dropped_blocks", 0):
        log_info(f"ocr: dropped {ocr_engine.dropped_blocks} low-confidence blocks")

    return "\n\n".join(blocks) + ("\n" if blocks else "")


def convert_document(
    source: Path,
    include_images: bool = True,
    password: str | None = None,
    use_ocr: bool = True,
    ocr_engine: OcrEngine | None = None,
    ocr_cache: dict[str, str] | None = None,
    max_pages: int | None = None,
    max_image_pixels: int | None = None,
) -> str:
    suffix = source.suffix.lower()
    if suffix not in SUPPORTED_EXTENSIONS:
        raise ValueError(f"unsupported input format: {source.suffix}")
    try:
        if suffix == ".docx":
            return convert_docx(source, include_images, password)
        if suffix == ".pptx":
            return convert_pptx(source, include_images, password)
        return convert_pdf(
            source,
            include_images,
            password,
            use_ocr,
            ocr_engine=ocr_engine,
            ocr_cache=ocr_cache,
            max_pages=max_pages,
            max_image_pixels=max_image_pixels,
        )
    except (CorruptDocumentError, EncryptedDocumentError, OcrError, BudgetError):
        raise
    except Exception as exc:
        raise CorruptDocumentError(f"corrupt document: {source}") from exc


IMAGE_EXTENSIONS = {
    "image/png": ".png",
    "image/jpeg": ".jpg",
    "image/gif": ".gif",
    "image/webp": ".webp",
    "image/svg+xml": ".svg",
    "image/bmp": ".bmp",
    "image/tiff": ".tiff",
    "image/x-wmf": ".wmf",
    "image/x-emf": ".emf",
    "image/jpx": ".jpx",
    "image/jp2": ".jp2",
    "image/jbig2": ".jbig2",
}
DATA_URI_RE = re.compile(r"!\[([^\]]*)\]\(data:(image/[^;)]+);base64,([A-Za-z0-9+/=]+)\)")

DISALLOWED_CATEGORY_RANGES = [
    (0, 8), (11, 12), (14, 31), (127, 159), (173, 173), (1536, 1541),
    (1564, 1564), (1757, 1757), (1807, 1807), (2192, 2193), (2274, 2274),
    (6158, 6158), (8203, 8207), (8234, 8238), (8288, 8292), (8294, 8303),
    (55296, 63743), (65279, 65279), (65529, 65531), (69821, 69821),
    (69837, 69837), (78896, 78911), (113824, 113827), (119155, 119162),
    (917505, 917505), (917536, 917631), (983040, 1048573), (1048576, 1114109),
]
_DISALLOWED_TRANSLATION: dict[int, None] | None = None


def get_disallowed_translation() -> dict[int, None]:
    global _DISALLOWED_TRANSLATION
    if _DISALLOWED_TRANSLATION is None:
        _DISALLOWED_TRANSLATION = {
            cp: None
            for start, end in DISALLOWED_CATEGORY_RANGES
            for cp in range(start, end + 1)
        }
    return _DISALLOWED_TRANSLATION


def _normalize_prose(segment: str) -> str:
    text = unicodedata.normalize("NFC", segment)
    text = text.translate(get_disallowed_translation())
    return text.translate(TYPOGRAPHY_TRANSLATION)


def _normalize_markdown_line(line: str) -> str:
    if REFERENCE_DEF_RE.match(line):
        return line
    parts: list[str] = []
    position = 0
    for match in INLINE_PROTECT_RE.finditer(line):
        parts.append(_normalize_prose(line[position : match.start()]))
        parts.append(match.group(0))
        position = match.end()
    parts.append(_normalize_prose(line[position:]))
    return "".join(parts)


def normalize_typography(markdown: str) -> str:
    """Normalise prose typography without rewriting code or link destinations."""
    lines = markdown.splitlines(keepends=True)
    output: list[str] = []
    fence_state: tuple[str, int] | None = None
    for line in lines:
        body = line.rstrip("\r\n")
        suffix = line[len(body) :]
        info = fence_info(body)
        if info is not None:
            output.append(body + suffix)
            if fence_state is None:
                fence_state = (info[0], info[1])
            elif fence_state[0] == info[0] and info[1] >= fence_state[1] and not info[2]:
                fence_state = None
            continue
        if fence_state is not None:
            output.append(body + suffix)
        else:
            output.append(_normalize_markdown_line(body) + suffix)
    return "".join(output)


def sanitize_ascii(markdown: str) -> str:
    """Backward-compatible alias for normalize_typography."""
    return normalize_typography(markdown)


ASSET_FILE_RE = re.compile(r"^image-\d{3,}\.[A-Za-z0-9]+$")


def _clear_generated_assets(assets: Path) -> None:
    if not assets.is_dir():
        return
    for path in assets.iterdir():
        if path.is_file() and ASSET_FILE_RE.match(path.name):
            path.unlink()
    try:
        assets.rmdir()
    except OSError:
        pass


def write_markdown(markdown: str, output: Path) -> None:
    output.parent.mkdir(parents=True, exist_ok=True)
    assets = output.parent / f"{output.stem}.assets"
    if not DATA_URI_RE.search(markdown):
        output.write_text(markdown, encoding="utf-8")
        _clear_generated_assets(assets)
        return

    temp_assets = assets.with_name(
        f".{assets.name}.tmp-{os.getpid()}-{threading.get_ident()}"
    )
    if temp_assets.exists():
        shutil.rmtree(temp_assets)
    temp_assets.mkdir(parents=True)
    counter = 0

    def replace(match: re.Match[str]) -> str:
        nonlocal counter
        counter += 1
        content_type = match.group(2)
        extension = IMAGE_EXTENSIONS.get(content_type, ".bin")
        name = f"image-{counter:03d}{extension}"
        (temp_assets / name).write_bytes(base64.b64decode(match.group(3)))
        href = quote(f"{assets.name}/{name}")
        return f"![{match.group(1)}]({href})"

    rendered = DATA_URI_RE.sub(replace, markdown)
    if assets.is_dir():
        for path in assets.iterdir():
            if path.is_file() and not ASSET_FILE_RE.match(path.name):
                shutil.copy2(path, temp_assets / path.name)
        shutil.rmtree(assets)
    temp_assets.replace(assets)
    output.write_text(rendered, encoding="utf-8")


def discover_documents(source: Path, exclude: Path | None = None) -> list[Path]:
    documents = []
    excluded = exclude.resolve() if exclude is not None else None
    for path in source.rglob("*"):
        if not path.is_file():
            continue
        if excluded is not None and path.resolve().is_relative_to(excluded):
            continue
        relative = path.relative_to(source)
        if any(part.startswith(".") for part in relative.parts):
            continue
        if path.suffix.lower() in SUPPORTED_EXTENSIONS:
            documents.append(path)
    return sorted(documents)


def exit_code_for(exc: Exception) -> int:
    if isinstance(exc, EncryptedDocumentError):
        return 3
    if isinstance(exc, CorruptDocumentError):
        return 2
    return 1


def convert_source(
    source: Path,
    options: ConversionOptions,
    ocr_engine: OcrEngine | None = None,
    ocr_cache: dict[str, str] | None = None,
) -> tuple[str | None, int]:
    try:
        try:
            size = source.stat().st_size
        except OSError:
            size = 0
        if size > options.max_bytes:
            raise BudgetError(
                f"byte budget exceeded for {source}: {size} bytes "
                f"(limit {options.max_bytes})"
            )
        markdown = convert_document(
            source,
            include_images=options.include_images,
            password=options.password,
            use_ocr=options.use_ocr,
            ocr_engine=ocr_engine,
            ocr_cache=ocr_cache,
            max_pages=options.max_pages,
            max_image_pixels=options.max_image_pixels,
        )
        if not markdown.strip():
            raise CorruptDocumentError(
                f"no content could be extracted from {source}"
            )
    except Exception as exc:
        print(f"docmd: error: {exc}", file=sys.stderr)
        return None, exit_code_for(exc)
    if options.sanitize:
        markdown = normalize_typography(markdown)
    return markdown, 0


def report_verify_errors(markdown: str, base_dir: Path) -> int:
    errors, counts = verify_markdown_counts(markdown, base_dir)
    log_info(
        "verify: checked "
        f"{counts['fences']} fence(s), {counts['tables']} table(s), "
        f"{counts['links']} link(s), {counts['images']} image(s)"
    )
    if errors:
        print("\n".join(errors), file=sys.stderr)
        return 1
    return 0


def document_output_path(out: Path, source: Path, document: Path) -> Path:
    relative = document.relative_to(source)
    return out / relative.parent / f"{relative.stem}.md"


def convert_one(
    document: Path,
    output: Path,
    options: ConversionOptions,
    ocr_engine: OcrEngine | None = None,
    ocr_cache: dict[str, str] | None = None,
    announce: bool = True,
) -> int:
    markdown, status = convert_source(
        document, options, ocr_engine=ocr_engine, ocr_cache=ocr_cache
    )
    if status != 0:
        return status
    try:
        write_markdown(markdown or "", output)
    except OSError as exc:
        print(f"docmd: error: cannot write {output}: {exc}", file=sys.stderr)
        return 1
    if options.verify:
        try:
            verified_text = output.read_text(encoding="utf-8")
        except OSError as exc:
            print(f"docmd: error: cannot read {output}: {exc}", file=sys.stderr)
            return 1
        if report_verify_errors(verified_text, output.parent):
            return 1
    if announce and not options.quiet:
        print(f"docmd: wrote {output}", file=sys.stderr)
    return 0


def commit_staged_output(staged: Path, final: Path) -> None:
    final.parent.mkdir(parents=True, exist_ok=True)
    staged_assets = staged.parent / f"{staged.stem}.assets"
    final_assets = final.parent / f"{final.stem}.assets"
    if staged_assets.is_dir():
        final_assets.mkdir(parents=True, exist_ok=True)
        for path in final_assets.iterdir():
            if path.is_file() and ASSET_FILE_RE.match(path.name):
                path.unlink()
        for path in staged_assets.iterdir():
            shutil.move(str(path), final_assets / path.name)
        try:
            staged_assets.rmdir()
        except OSError:
            pass
    else:
        _clear_generated_assets(final_assets)
    staged.replace(final)


def convert_directory(
    source: Path, out: Path, options: ConversionOptions
) -> int:
    if options.stdout:
        print(
            "docmd: error: --stdout is not supported for directory input",
            file=sys.stderr,
        )
        return 1
    try:
        out.mkdir(parents=True, exist_ok=True)
    except OSError as exc:
        print(f"docmd: error: cannot create output directory: {exc}", file=sys.stderr)
        return 1

    source_root = source.resolve()
    out_root = out.resolve()
    exclude = (
        out_root
        if out_root != source_root and out_root.is_relative_to(source_root)
        else None
    )
    documents = discover_documents(source, exclude)

    seen_outputs: dict[Path, Path] = {}
    for document in documents:
        dest = document_output_path(out, source, document)
        if dest in seen_outputs:
            print(
                f"docmd: error: stem collision: '{document}' and '{seen_outputs[dest]}' both target '{dest}'",
                file=sys.stderr,
            )
            return 1
        seen_outputs[dest] = document

    ocr_engine = load_ocr_engine() if options.use_ocr else None
    ocr_cache = OcrCache()
    stage_root = Path(tempfile.mkdtemp(prefix=".docmd-stage-", dir=out))
    results: dict[Path, tuple[Path, int]] = {}

    def staged_path(document: Path) -> Path:
        relative = document.relative_to(source)
        return stage_root / relative.parent / f"{relative.stem}.md"

    try:
        if options.jobs == 1:
            for document in documents:
                output = staged_path(document)
                status = convert_one(
                    document,
                    output,
                    options,
                    ocr_engine=ocr_engine,
                    ocr_cache=ocr_cache,
                    announce=False,
                )
                results[document] = (output, status)
        else:
            def run_worker(doc: Path, output_path: Path) -> tuple[Path, int]:
                status = convert_one(
                    doc,
                    output_path,
                    options,
                    ocr_engine=ocr_engine,
                    ocr_cache=ocr_cache,
                    announce=False,
                )
                return (output_path, status)

            with ThreadPoolExecutor(max_workers=options.jobs) as pool:
                futures = {
                    pool.submit(run_worker, document, staged_path(document)): document
                    for document in documents
                }
                for future in as_completed(futures):
                    document = futures[future]
                    output_path, status = future.result()
                    results[document] = (output_path, status)

        first_error: int | None = None
        for document in documents:
            staged, status = results[document]
            if status != 0:
                first_error = status
                break
            final = document_output_path(out, source, document)
            try:
                commit_staged_output(staged, final)
            except OSError as exc:
                print(f"docmd: error: cannot write {final}: {exc}", file=sys.stderr)
                first_error = 1
                break
            if not options.quiet:
                print(f"docmd: wrote {final}", file=sys.stderr)
        if first_error is not None:
            for stale in documents[documents.index(document) :]:
                final = document_output_path(out, source, stale)
                try:
                    if final.is_file():
                        final.unlink()
                    _clear_generated_assets(final.parent / f"{final.stem}.assets")
                except OSError as exc:
                    log_warning(f"cannot remove stale output {final}: {exc}")
        return first_error or 0
    finally:
        shutil.rmtree(stage_root, ignore_errors=True)


def main() -> int:
    global _QUIET
    args = build_parser().parse_args()
    _QUIET = args.quiet
    if not args.input_path or not args.input_path.strip():
        print("docmd: error: input path cannot be empty", file=sys.stderr)
        return 1
    if args.jobs < 1:
        print("docmd: error: --jobs must be at least 1", file=sys.stderr)
        return 1
    if args.password:
        log_warning(
            "--password exposes the secret in the process list; "
            "prefer DOCMD_PASSWORD"
        )
    try:
        if not args.no_ocr:
            OcrConfig.from_env()
        options = ConversionOptions.from_args(args)
    except ValueError as exc:
        print(f"docmd: error: {exc}", file=sys.stderr)
        return 1
    source = Path(args.input_path)
    if not source.exists():
        print(f"docmd: error: input not found: {source}", file=sys.stderr)
        return 1

    if source.is_dir():
        return convert_directory(source, Path(args.out), options)

    markdown, status = convert_source(source, options)
    if status != 0:
        return status

    if options.stdout:
        if options.verify and report_verify_errors(markdown or "", Path.cwd()):
            return 1
        try:
            sys.stdout.reconfigure(encoding="utf-8")
            sys.stdout.write(markdown or "")
        except BrokenPipeError:
            pass
        return 0

    out = Path(args.out)
    if out.is_dir() or not out.suffix:
        try:
            out.mkdir(parents=True, exist_ok=True)
        except OSError as exc:
            print(f"docmd: error: cannot create output directory: {exc}", file=sys.stderr)
            return 1
        output = out / f"{source.stem}.md"
    else:
        try:
            out.parent.mkdir(parents=True, exist_ok=True)
        except OSError as exc:
            print(f"docmd: error: cannot create output directory: {exc}", file=sys.stderr)
            return 1
        output = out

    try:
        if output.resolve() == source.resolve():
            print(
                f"docmd: error: output path is the input path: {output}",
                file=sys.stderr,
            )
            return 1
    except OSError:
        pass

    try:
        write_markdown(markdown or "", output)
    except OSError as exc:
        print(f"docmd: error: cannot write output: {exc}", file=sys.stderr)
        return 1

    if options.verify:
        try:
            verified_text = output.read_text(encoding="utf-8")
        except OSError as exc:
            print(f"docmd: error: cannot read output: {exc}", file=sys.stderr)
            return 1
        if report_verify_errors(verified_text, output.parent):
            return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
